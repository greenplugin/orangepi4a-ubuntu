FROM arm64v8/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential gcc g++ \
    gcc-arm-linux-gnueabi g++-arm-linux-gnueabi \
    bc kmod cpio flex libncurses5-dev \
    libelf-dev libssl-dev bison lzop lz4 \
    swig python3-dev python3-setuptools \
    ccache xxd \
    debootstrap \
    qemu-user-static binfmt-support \
    u-boot-tools device-tree-compiler \
    git wget curl rsync xz-utils busybox \
    uuid-runtime ca-certificates \
    && for r in noble plucky questing resolute; do \
         [ -e "/usr/share/debootstrap/scripts/$r" ] || ln -s gutsy "/usr/share/debootstrap/scripts/$r"; \
       done \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
